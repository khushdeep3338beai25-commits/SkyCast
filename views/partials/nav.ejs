<style>
    /* Navbar Styling */

.navbar{
    width:100%;
    height:80px;
    padding:0 70px;
    background:rgba(10, 25, 47, 0.9);
    backdrop-filter:blur(12px);
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:fixed;
    top:0;
    left:0;
    z-index:1000;
    box-shadow:0 4px 20px rgba(0,0,0,0.2);
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
    color:#fff;
    font-size:28px;
    font-weight:700;
}

.nav-links{
    display:flex;
    list-style:none;
    gap:45px;
}

.nav-links li{
    list-style:none;
}

.nav-links a{
    text-decoration:none;
    color:#fff;
    font-size:18px;
    font-weight:500;
    position:relative;
    transition:0.3s ease;
}

.nav-links a::after{
    content:"";
    position:absolute;
    left:0;
    bottom:-6px;
    width:0;
    height:3px;
    background:#4facfe;
    border-radius:10px;
    transition:0.4s;
}

.nav-links a:hover{
    color:#4facfe;
}

.nav-links a:hover::after{
    width:100%;
}

.unit-btn{
    padding:10px 22px;
    border:2px solid #4facfe;
    border-radius:12px;
    background:transparent;
    color:#fff;
    font-size:18px;
    font-weight:600;
    cursor:pointer;
    transition:0.3s;
}

.unit-btn:hover{
    background:#4facfe;
    color:#fff;
    transform:scale(1.05);
}
</style>

<nav class="navbar">
    <div class="logo">
        🌤️ <span>SkyCast </span>
    </div>

    <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/forecast">Forecast</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/footer">Contact</a></li>
    </ul>

    
</nav>